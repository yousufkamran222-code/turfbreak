{
  "name": "turfbreak",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "description": "A build-then-watch territory roguelite.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "VITE_PLATFORM=web vite build",
    "build:crazygames": "VITE_PLATFORM=crazygames vite build",
    "build:android": "VITE_PLATFORM=android vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:size": "node tools/check-size.mjs dist",
    "check": "npm run lint && npm run typecheck && npm test",
    "lab": "tsx tools/lab.ts"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@types/d3-delaunay": "^6.0.4",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@preact/signals": "^2.11.4",
    "d3-delaunay": "^6.0.6",
    "preact": "^11.2.0"
  }
}
